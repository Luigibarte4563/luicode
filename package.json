{
  "name": "luicode",
  "version": "0.2.0",
  "description": "LUICode — autonomous AI coding agent CLI with an interactive terminal UI. Plan. Build. Test. Ship.",
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "terminal-ui",
    "llm",
    "openai",
    "anthropic",
    "ollama",
    "litellm"
  ],
  "license": "MIT",
  "bin": {
    "luicode": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config",
    "public"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "tsc --noEmit",
    "dev": "ts-node src/cli/index.ts",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "express": "^4.18.2",
    "fast-check": "^4.9.0",
    "typescript": "^5.5.3",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2"
  }
}
